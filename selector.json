{
  "selectors": {
    "captcha": [
      "iframe[src*=\"arkoselabs\"]",
      "iframe[src*=\"funcaptcha\"]",
      "iframe[src*=\"recaptcha\"]",
      "iframe[title*=\"CAPTCHA\"]",
      "iframe[title*=\"Verification\"]",
      "div[id*=\"captcha\"]",
      "div[class*=\"captcha\"]",
      ".g-recaptcha",
      "#arkose-iframe",
      "iframe[src*=\"arkose\"]"
    ],
    "email_field": [
      "input[name=\"email\"]",
      "input[type=\"email\"]",
      "input[placeholder*=\"Email\"]",
      "input[placeholder*=\"email\"]",
      "input[id*=\"email\"]"
    ],
    "continue_button": [
      "button.email-submit-button",
      "button[type=\"submit\"].email-submit-button",
      "button[data-testid*=\"continue\"]",
      "input[type=\"submit\"]"
    ],
    "first_name": [
      "input[id^=\"fname\"]",
      "input[name=\"fname\"]",
      "input[autocomplete=\"given-name\"]",
      "input[placeholder*=\"First name\"]",
      "input[placeholder*=\"Nama depan\"]"
    ],
    "last_name": [
      "input[id^=\"lname\"]",
      "input[name=\"lname\"]",
      "input[autocomplete=\"family-name\"]",
      "input[placeholder*=\"Last name\"]",
      "input[placeholder*=\"Nama belakang\"]"
    ],
    "password": [
      "input[id^=\"password\"]",
      "input[name=\"password\"]",
      "input[type=\"password\"]",
      "input[placeholder*=\"Password\"]",
      "input[placeholder*=\"Kata sandi\"]"
    ],
    "tos_checkbox": [
      "input[type=\"checkbox\"][name=\"tos_agree\"]",
      "input[type=\"checkbox\"]",
      ".agree-checkbox"
    ],
    "submit_button": [
      "button._register-button_1k6no_4",
      "button[type=\"submit\"]._register-button_1k6no_4",
      "button[data-testid*=\"submit\"]",
      "input[type=\"submit\"]"
    ],
    "verify_email": [
      "button[aria-label=\"Verify email\"]",
      "button.account-key-value-block__link",
      "button[data-testid*=\"verify-email\"]",
      "a[data-testid*=\"verify-email\"]"
    ],
    "send_email": [
      "button.js-email-modal-button.dig-Button--primary",
      "button[data-testid*=\"send-email\"]",
      "button[type=\"submit\"].js-email-modal-button"
    ],
    "resend_email": [
      "button[data-testid*=\"resend\"]",
      "button.js-email-modal-button",
      "button[type=\"submit\"].js-email-modal-button"
    ],
    "register": {
      "username": "#username",
      "email": "#email",
      "password": "#password",
      "passwordConfirm": "#confirm_password",
      "submit": [
        "button[type='submit']",
        "button[data-testid*=\"submit\"]",
        "input[type='submit']"
      ]
    },
    "cliLink": {
      "connectButton": "button, input[type=\"submit\"], a, [role=\"button\"]"
    },
    "settings": {
      "verifyEmail": [
        "button[aria-label=\"Verify email\"]",
        "button.account-key-value-block__link",
        "button[data-testid*=\"verify-email\"]",
        "a[data-testid*=\"verify-email\"]"
      ]
    },
    "verifyEmail": {
      "sendButton": [
        "button[data-testid*=\"send\"]",
        "button[type='submit']",
        "input[type='submit']"
      ]
    },
    "accountSetup": {
      "storageOption": ".account-setup-flow__option, .setup-flow-option, [data-testid='storage-option']",
      "continueButton": [
        "button[data-testid*=\"continue\"]",
        "button[type='submit']",
        "input[type='submit']"
      ]
    },
    "finalPage": {
      "finishButton": [
        "button[data-testid*=\"finish\"]",
        "button[type='submit']",
        "input[type='submit']"
      ],
      "skipButton": [
        "button[data-testid*=\"skip\"]",
        "a[data-testid*=\"skip\"]",
        "button:has(> span:text('Skip'))"
      ]
    }
  },
  "defaults": {
    "globalTimeout": 60,
    "daemonTimeout": 120,
    "maxTabAttempts": 3,
    "maxCliAttempts": 3,
    "maxVerifAttempts": 3,
    "maxSetupAttempts": 3,
    "maxFinalAttempts": 3
  }
}
